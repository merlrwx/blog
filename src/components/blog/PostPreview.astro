---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
const tags: string[] = post.data.tags;
---

<FormattedDate
	class="text-muted block text-sm font-semibold"
	date={post.data.publishDate}
/>
<Tag class:list={["mt-2", withDesc ? "text-xl leading-tight" : ""]}>
	{post.data.draft && <span class="text-red-500">(Draft) </span>}
	<a class="cactus-link" href={`/posts/${post.id}/`}>
		{post.data.title}
	</a>
</Tag>
{
	withDesc && (
		<>
			<p class="mt-2 line-clamp-3 text-sm leading-6 text-muted">{post.data.description}</p>
			{!!tags.length && (
				<ul class="mt-3 flex flex-wrap gap-2" aria-label="Post tags">
					{tags.map((tag) => (
						<li>
							<a
								class="hover:border-accent hover:text-accent bg-surface inline-flex rounded border border-border px-2 py-1 text-xs leading-none text-muted transition-colors"
								href={`/tags/${tag}/`}
							>
								{tag}
							</a>
						</li>
					))}
				</ul>
			)}
		</>
	)
}
